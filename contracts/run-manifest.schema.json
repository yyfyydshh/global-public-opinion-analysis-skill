{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"run-manifest.schema.json","title":"Public Opinion Run Manifest","type":"object","required":["schema_version","run_id","topic","topic_hash","scope_decision","report_mode","source_policy","target_records","time_window","phase","artifacts","processed_batches","gate","html_offer","updated_at"],"properties":{"schema_version":{"const":"2.1"},"run_id":{"type":"string","minLength":8},"topic":{"type":"string"},"topic_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"scope_decision":{"enum":["allowed","blocked"]},"report_mode":{"enum":["product_voc","event_reputation"]},"source_policy":{"oneOf":[{"$ref":"source-policy.schema.json"},{"type":"null"}]},"target_records":{"type":["integer","null"],"minimum":1,"maximum":1000},"time_window":{"type":"object","required":["requested","effective_days"],"properties":{"requested":{"type":"string"},"effective_days":{"type":"integer","minimum":1,"maximum":90}},"additionalProperties":true},"phase":{"enum":["screened","collecting","previewed","cleaned","gated","analyzed","rendered","html_offered","html_rendered","delivered","scope_blocked"]},"artifacts":{"type":"object","additionalProperties":{"type":"string"}},"processed_batches":{"type":"integer","minimum":0},"gate":{"type":"object","required":["passed","status"],"properties":{"passed":{"type":"boolean"},"status":{"type":"string"}},"additionalProperties":true},"html_offer":{"type":"object","required":["status"],"properties":{"status":{"enum":["not_applicable","not_offered","pending","accepted","declined","generated"]},"asked_at":{"type":["string","null"],"format":"date-time"},"answered_at":{"type":["string","null"],"format":"date-time"}},"additionalProperties":true},"updated_at":{"type":"string","format":"date-time"}},"additionalProperties":true}
